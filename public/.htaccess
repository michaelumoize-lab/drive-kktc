# cPanel Apache Configuration for Drive KKTC Static Export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect root / to /tr/
  RewriteRule ^$ /tr/ [R=301,L]

  # 2. Redirect language without trailing slash (/tr -> /tr/ and /en -> /en/)
  RewriteRule ^(tr|en)$ /$1/ [R=301,L]

  # 3. Redirect unlocalized legacy URLs to /tr/...
  RewriteRule ^(about|faq|guide|testimonials|routes)(/.*)?$ /tr/$1$2 [R=301,L]

  # 4. Serve static html files directly if file exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
