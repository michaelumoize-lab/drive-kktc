# cPanel Apache Configuration for Drive North Cyprus Static Export

# 1. Prevent directory listing (disables "Index of /" screens)
Options -Indexes

# 2. Tell Apache to look for index.html inside any directory
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3. Redirect root / to /tr/
  RewriteRule ^$ /tr/ [R=301,L]

  # 4. Redirect language without trailing slash (/tr -> /tr/ and /en -> /en/)
  RewriteRule ^(tr|en)$ /$1/ [R=301,L]

  # 5. Redirect legacy unlocalized URLs to /tr/...
  RewriteRule ^(about|faq|guide|testimonials|routes)(/.*)?$ /tr/$1$2/ [R=301,L]

  # 6. Compatibility: If tr.html / en.html exists in root and user requests /tr/ or /en/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(tr|en)/?$ /$1.html [L]

  # 7. Compatibility: If user requests /tr/routes/ and routes.html exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/$ /$1.html [L]

  # 8. Clean URLs: if request is /path and path.html exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
